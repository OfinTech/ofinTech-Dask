{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desk.ofintech.ai/schemas/embedded/v1/FinancialKpiCard.json",
  "title": "FinancialKpiCard",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 200
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "money",
        "percent",
        "date"
      ]
    },
    "currency": {
      "type": "string",
      "maxLength": 3
    },
    "period": {
      "type": "string",
      "maxLength": 200
    },
    "change": {
      "type": [
        "number",
        "null"
      ]
    },
    "tone": {
      "type": "string",
      "enum": [
        "neutral",
        "good",
        "warn",
        "bad"
      ]
    }
  },
  "required": [
    "version",
    "label",
    "value"
  ]
}
