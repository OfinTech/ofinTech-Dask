{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desk.ofintech.ai/schemas/embedded/v1/FinancialSourceReference.json",
  "title": "FinancialSourceReference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "snippet": {
            "type": "string",
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "maxLength": 200
          },
          "document_id": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "n",
          "name"
        ]
      }
    }
  },
  "required": [
    "version",
    "items"
  ]
}
