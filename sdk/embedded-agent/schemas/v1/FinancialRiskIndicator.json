{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desk.ofintech.ai/schemas/embedded/v1/FinancialRiskIndicator.json",
  "title": "FinancialRiskIndicator",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "high"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "detail": {
      "type": "string",
      "maxLength": 500
    },
    "figures": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  },
  "required": [
    "version",
    "level",
    "title"
  ]
}
