{
 "uid": "desk-finance",
 "title": "OfinTech Desk \u00b7 Financial reliability",
 "tags": [
  "ofintech-desk"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "utc",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Financial tool errors",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tool) (increase(desk_tool_calls_total{status=\"error\",tool=~\"calc_.*|financial_kpis|kpi_detail|forecast_report|cost_centre_.*|query_dataset|month_end_close\"}[1h]))",
     "legendFormat": "{{tool}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Figures in answers by provenance",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (provenance) (increase(desk_figures_total[1h]))",
     "legendFormat": "{{provenance}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Answers with unsupported figures",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(desk_answers_total{figures=\"unsupported\"}[1h])) / sum(increase(desk_answers_total[1h]))",
     "legendFormat": "share"
    }
   ]
  },
  {
