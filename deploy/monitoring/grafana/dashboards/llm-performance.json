{
 "uid": "desk-llm",
 "title": "OfinTech Desk \u00b7 LLM performance",
 "tags": [
  "ofintech-desk"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "utc",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Model call duration P50 / P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum(rate(desk_llm_call_seconds_bucket[15m])) by (le))",
     "legendFormat": "P50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(desk_llm_call_seconds_bucket[15m])) by (le))",
     "legendFormat": "P95"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Time to first token P50 / P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum(rate(desk_llm_ttfb_seconds_bucket[15m])) by (le))",
     "legendFormat": "P50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(desk_llm_ttfb_seconds_bucket[15m])) by (le))",
     "legendFormat": "P95"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Output tokens per second (all calls)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(desk_llm_tokens_total{kind=\"output\"}[5m]))",
     "legendFormat": "tokens/s"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Model availability (calls that succeeded)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(desk_llm_calls_total{outcome=\"ok\"}[15m])) / sum(rate(desk_llm_calls_total[15m]))",
     "legendFormat": "ok"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Context: history budget used P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(desk_llm_history_budget_ratio_bucket[1h])) by (le))",
     "legendFormat": "P95 share"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Characters sent per call P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(desk_llm_request_chars_bucket[1h])) by (le))",
     "legendFormat": "P95"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Finish reasons",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (reason) (increase(desk_llm_finish_total[1h]))",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Retries by cause",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (code) (increase(desk_llm_retries_total[1h]))",
     "legendFormat": "{{code}}"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}