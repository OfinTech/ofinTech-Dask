{
 "uid": "desk-agent",
 "title": "OfinTech Desk \u00b7 AI agent overview",
 "tags": [
  "ofintech-desk"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "utc",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Runs per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(desk_agent_runs_started_total[5m])) * 60",
     "legendFormat": "started"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Run success rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(desk_agent_runs_total{outcome=\"completed\"}[15m])) / sum(rate(desk_agent_runs_total{outcome!=\"cancelled\"}[15m]))",
     "legendFormat": "completed"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Run duration P50 / P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum(rate(desk_agent_run_seconds_bucket[15m])) by (le))",
     "legendFormat": "P50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum(rate(desk_agent_run_seconds_bucket[15m])) by (le))",
     "legendFormat": "P95"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Runs by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (increase(desk_agent_runs_total[1h]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Active runs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "desk_agent_runs_active",
     "legendFormat": "active"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tool failure rate by tool",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tool) (rate(desk_tool_calls_total{status=\"error\"}[15m])) / sum by (tool) (rate(desk_tool_calls_total[15m]))",
     "legendFormat": "{{tool}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Run errors by code",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (code) (increase(desk_agent_run_errors_total[1h]))",
     "legendFormat": "{{code}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Model errors by class",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (increase(desk_llm_calls_total{outcome!=\"ok\"}[1h]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}