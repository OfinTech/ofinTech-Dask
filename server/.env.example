# OfinTech Desk Team Server settings. Copy to .env and fill in. Never commit .env.

# Public host name (DNS A/AAAA record pointing at this server)
DESK_DOMAIN=desk.ofintech.ai
# E-mail for Let's Encrypt certificate notices
ACME_EMAIL=it@example.com
# 32 random bytes, base64. Generate:
#   python3 -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# (or, once the image is built: docker run --rm ofintech-desk:local python -m desk_engine keygen)
# Back it up separately: without it stored credentials cannot be decrypted.
DESK_MASTER_KEY=

# Allow anyone to sign up (default: false = invitation only after the first account)
DESK_OPEN_SIGNUP=false

# The public website whose sign-in and sign-up forms post to this server (origin only, https). The website and this
# server must share a domain (ofintech.ai and desk.ofintech.ai) so the session cookie reaches the app. Leave empty
# when the app's own sign-in page is used.
DESK_SITE_URL=https://ofintech.ai

# Optional: OAuth apps provided by the operator (otherwise set them in the app under Connections -> OAuth apps)
# Redirect URI to register with each provider: https://<DESK_DOMAIN>/oauth/callback
DESK_QUICKBOOKS_CLIENT_ID=
DESK_QUICKBOOKS_CLIENT_SECRET=
DESK_ZOHO_BOOKS_CLIENT_ID=
DESK_ZOHO_BOOKS_CLIENT_SECRET=
DESK_XERO_CLIENT_ID=
DESK_XERO_CLIENT_SECRET=
DESK_GOOGLE_CLIENT_ID=
DESK_GOOGLE_CLIENT_SECRET=

# --- Sign-in ----------------------------------------------------------------------------------------------
# "Continue with Google" appears once the Google OAuth app above (or under Connections -> OAuth apps) is set.
# It uses the same redirect URI. Only e-mail addresses Google has verified are accepted. Limit sign-in to your
# company's domains (comma-separated); empty = any verified Google account that has been invited.
DESK_GOOGLE_ALLOWED_DOMAINS=

# --- Outgoing e-mail (invitations, password resets) ---------------------------------------------------------
# Without SMTP, invitations and reset links are shown in the app for an administrator to pass on.
DESK_SMTP_HOST=
DESK_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (local relay only)
DESK_SMTP_SECURITY=starttls
DESK_SMTP_USER=
DESK_SMTP_PASSWORD=
# The sender, e.g. OfinTech Desk <desk@example.com>
DESK_SMTP_FROM=

# --- Documents ------------------------------------------------------------------------------------------------
# OCR for scanned PDFs and images with Tesseract (installed in the image with English, Arabic, Spanish and French)
DESK_OCR=true
DESK_OCR_LANGS=eng+ara+spa+fra

# --- Other ----------------------------------------------------------------------------------------------------
DESK_MAX_UPLOAD_MB=25
# Sign out after this long with no activity: 30 to 45 minutes (values outside are pulled into the range).
# The page warns two minutes before. An active person is never signed out.
DESK_SESSION_IDLE_MINUTES=30
# Absolute lifetime of a session in hours (1-24), and the shorter one for administrators and owners.
DESK_SESSION_HOURS=12
DESK_ADMIN_SESSION_HOURS=8
# High-risk actions ask for the password again unless it was entered within this many minutes.
DESK_REAUTH_MINUTES=10
DESK_WHATSAPP_GRAPH_VERSION=v26.0
# Send only the tool groups a request needs (smaller, cheaper requests). Set to off to send every tool.
DESK_TOOL_SELECTION=on
DESK_LOG_LEVEL=INFO
# Never set DESK_DEV on a server; the engine refuses to start with it. DESK_PUBLIC_URL must be https://.

# --- File storage ---------------------------------------------------------------------------------------
# Default: the engine's data volume. To use MinIO from this folder:
#   docker compose -f docker-compose.yml -f docker-compose.minio.yml up -d
# and fill in the four values below (all different, long and random; e.g. openssl rand -hex 24).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
DESK_S3_ACCESS_KEY=
DESK_S3_SECRET_KEY=
# DESK_S3_BUCKET=ofintech-desk-files
#
# Any other S3-compatible store instead (no overlay needed):
# DESK_STORAGE=s3
# DESK_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com   (empty = AWS in DESK_S3_REGION)
# DESK_S3_REGION=eu-central-1
# DESK_S3_BUCKET=
# DESK_S3_PREFIX=
# DESK_S3_PATH_STYLE=false
# DESK_S3_SSE=AES256                 (server-side encryption header, optional)
# DESK_STORAGE_ENCRYPTION=true       (engine-side AES-256-GCM before upload; keep on)

# Encrypted backups (server/backup.sh): a key made with `python -m desk_engine keygen`, kept apart from the
# server and from DESK_MASTER_KEY. As a Docker secret: DESK_BACKUP_KEY_FILE=/run/secrets/backup_key
# DESK_BACKUP_KEY_FILE=

# ---- Owner Control Center (hosted SaaS edition) -----------------------------------------------------------------
# The open-source self-hosted edition has no plan limits: leave DESK_HOSTED unset. Set it to true only on the hosted
# service, where the Free/Pro/Enterprise plans, storage quotas and Stripe billing apply.
# DESK_HOSTED=false
# Platform owners, provisioned securely (never from the public sign-up form): e-mail addresses, comma-separated.
# Existing accounts get the role at start-up, new ones at sign-up. Alternatively: python -m desk_engine owner grant <email>
# DESK_PLATFORM_OWNERS=owner@example.com
# Stripe keys, SMTP, Google OAuth and every other platform setting are entered in the Owner Control Center
# (/#/owner) and stored encrypted under DESK_MASTER_KEY; they are not environment variables. External integrations stay
# off (sandbox) until configured there.
