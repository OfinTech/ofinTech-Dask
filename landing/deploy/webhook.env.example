# Copy to landing/deploy/webhook.env (never commit the real file) and fill in.
# A long random secret; paste the same value in GitHub -> Settings -> Webhooks -> Secret.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
# Absolute path of a checkout used ONLY for the website (not the one that runs the Team Server).
REPO_DIR=/opt/ofintech-site
SITE_DIR=landing
DEPLOY_BRANCH=main
DEPLOY_REPOSITORY=OfinTech/OfinTech-ofinTech-Dask
# Rebuild only when a push changes files under these paths.
DEPLOY_PATHS=landing/
# The compose files the website runs with on this server (space-separated, relative to landing/).
COMPOSE_FILES=docker-compose.yml docker-compose.desk.yml
