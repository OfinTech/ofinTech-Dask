{
  "name": "ofintech-copilotkit-embedded-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Example: OfinTech Desk's embedded financial agent inside a CopilotKit chat, and a partner backend that mints session tokens.",
  "scripts": {
    "server": "node server/index.mjs",
    "build": "esbuild src/main.tsx --bundle --format=esm --jsx=automatic --outfile=public/app.js",
    "start": "npm run build && npm run server"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.40",
    "@copilotkit/react-core": "^1.50.0",
    "@copilotkit/react-ui": "^1.50.0",
    "@ofintech/embedded-agent": "file:../../sdk/embedded-agent",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": { "esbuild": "0.28.2", "typescript": "^6.0.0" }
}
